# Quotex Account Credentials
email=your_quotex_email@gmail.com
password=your_quotex_password

# Broker Domain / Mirror (Optional: Leave blank for auto-detect or specify e.g. quotex.com, qxbroker.com, quotex.io)
host=https://qxbroker.com/

# Default API Output Timezone (e.g. UTC, UTC+6, EST, IST, +5.5)
timezone=UTC

# Historical Candle Retention & Download Range (in days, e.g. 1, 3, 5, 8)
RETENTION_DAYS=8